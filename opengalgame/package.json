{
  "name": "opengalgame",
  "version": "0.1.0",
  "description": "本地优先的 Galgame 桌面创作工具",
  "main": "./out/main/index.js",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node ./scripts/run-electron-vite.cjs dev",
    "dev:web": "vite --config vite.renderer.config.ts",
    "start": "node ./scripts/run-electron-vite.cjs preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint --cache .",
    "test": "vitest run",
    "test:e2e:prototype-home": "playwright test --config playwright.home.config.cjs",
    "test:e2e:home": "playwright test --config playwright.renderer.config.cjs tests/e2e/home.spec.cjs",
    "test:e2e:projects": "playwright test --config playwright.renderer.config.cjs tests/e2e/projects.spec.cjs",
    "test:e2e:workbench": "playwright test --config playwright.renderer.config.cjs tests/e2e/workbench.spec.cjs",
    "test:electron": "npm run build && node ./scripts/check-home-electron.cjs",
    "postinstall": "electron-builder install-app-deps",
    "build:win": "npm run build && electron-builder --win"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-boundaries": "^5.0.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^7.2.6",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@gsap/react": "^2.1.2",
    "@langchain/anthropic": "^1.5.11",
    "@langchain/core": "1.2.14",
    "@langchain/langgraph": "1.4.19",
    "@langchain/langgraph-checkpoint": "1.1.5",
    "@langchain/openai": "^1.6.0",
    "@radix-ui/react-select": "^2.3.7",
    "@streamdown/cjk": "^1.0.4",
    "@tanstack/react-query": "^5.104.0",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "deepagents": "1.7.0",
    "es-toolkit": "^1.52.0",
    "fast-xml-parser": "^5.11.2",
    "file-stream-rotator": "1.0.0",
    "file-type": "^22.1.1",
    "gsap": "^3.15.0",
    "isomorphic-git": "1.43.0",
    "langchain": "^1.5.15",
    "lucide-react": "^1.61.0",
    "md-blockkit": "file:../../md-blockkit",
    "nanoid": "^6.0.2",
    "openai": "^7.23.0",
    "pino": "10.1.0",
    "radix-ui": "^1.8.1",
    "sonner": "^2.0.8",
    "streamdown": "^2.7.1",
    "tailwind-merge": "^3.7.0",
    "use-stick-to-bottom": "^1.1.6",
    "webgal-engine": "^4.6.5",
    "webgal-parser": "^4.6.5",
    "ws": "^8.22.0",
    "zod": "4.6.5",
    "zustand": "^5.0.15"
  }
}
